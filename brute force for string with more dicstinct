class Solution:
    def betterString(self, s1, s2):

        def count(s):
            res = set()

            def fun(i, current):
                if i == len(s):
                    res.add(current)
                    return

                fun(i + 1, current + s[i])
                fun(i + 1, current)

            fun(0, "")
            return len(res)

        return s1 if count(s1) >= count(s2) else s2
