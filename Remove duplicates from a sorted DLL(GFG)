class Node:
    def __init__(self, value):
        self.data = value  # value stored in node
        self.next = None
        self.prev = None
        
class Solution:
    def removeDuplicates(self, headRef):
        # code here
       temp=headRef
       l=[]
       s=set()
       while temp :
            if temp.data not in s:
                s.add(temp.data)
                l.append(temp.data)
            temp=temp.next
       headRef=Node(l[0])
       temp=headRef
       for i in range(1,len(l)):
           temp.next=Node(l[i])
           temp.next.prev=temp
           temp=temp.next
       return headRef

